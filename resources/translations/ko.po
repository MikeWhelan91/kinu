msgid "Land Kinu in the tofu box. Anything that bounces out onto the counter is a tumble, and three tumbles end the run. You score the pile you keep."
msgstr "키누를 두부 상자에 넣어요. 카운터로 튀어나가면 실패로 치고, 세 번이면 끝. 남은 더미가 점수예요."

msgid "A narrow lacquer plate, no walls to catch a bad drop. Stack carefully: you score how tall it stands when it finally comes down."
msgstr "좁은 옻칠 접시뿐, 막아 줄 벽은 없어요. 신중하게 쌓아요. 무너질 때의 높이가 점수예요."

msgid "Pack ten Kinu to ship a box and win more time. Boxes keep coming until the clock runs out."
msgstr "키누 10개를 담으면 상자를 보내고 시간이 늘어나요. 시간이 끝날 때까지 상자가 계속 와요."

msgid "Sold in the Shop for %d beans."
msgstr "상점에서 콩 %d개에 팔아요."

msgid "Drag to spin"
msgstr "드래그해서 돌리기"

msgid "Tap a card for a closer look."
msgstr "카드를 탭하면 자세히 볼 수 있어요."

msgid "Unowned"
msgstr "미보유"

msgid "Buy for %s beans"
msgstr "콩 %s개로 구매"

msgid "Open Wardrobe"
msgstr "옷장 열기"

msgid "Wear"
msgstr "입히기"

msgid "Use"
msgstr "사용"

msgid "Glaze 50 Kinu with shoyu"
msgstr "키누 50개에 간장 뿌리기"

msgid "New flavour"
msgstr "새로운 맛"

