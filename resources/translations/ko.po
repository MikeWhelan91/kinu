msgid "A tiny crown, just in case that kiss works."
msgstr "그 키스가 통할 때를 대비한 작은 왕관."

msgid "A candy-coloured dragon, all softness and no fire."
msgstr "사탕 빛깔 드래곤. 폭신폭신하고 불은 안 뿜어요."

msgid "A frost-white coat, silent as falling snow."
msgstr "내리는 눈처럼 조용한 새하얀 털."

msgid "Trailing tendrils that glow like a lullaby."
msgstr "자장가처럼 빛나는 하늘하늘 촉수."

msgid "Gossamer wings and a sprinkle of pixie dust."
msgstr "얇은 날개와 요정 가루 한 줌."

msgid "Builder Helmet"
msgstr "공사 헬멧"

msgid "Balance Pole"
msgstr "균형 막대"

msgid "Shoyu Chef"
