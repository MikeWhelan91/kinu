msgid "just now"
msgstr "방금"

msgid "1 minute ago"
msgstr "1분 전"

msgid "%d minutes ago"
msgstr "%d분 전"

msgid "Progress sent to iCloud sync %s."
msgstr "%s iCloud에 진행 상황을 보냈어요."

msgid "iCloud has a game save. New progress will sync automatically."
msgstr "iCloud에 게임 저장 데이터가 있어요. 새 진행 상황은 자동으로 동기화돼요."

msgid "Waiting for the first iCloud sync."
msgstr "첫 iCloud 동기화를 기다리는 중이에요."

msgid "Last restored from iCloud: %s"
msgstr "마지막 iCloud 복원: %s"

msgid "Never"
msgstr "없음"

msgid "Sign in to Game Center to use iCloud saves."
msgstr "iCloud 저장을 사용하려면 Game Center에 로그인해 주세요."

msgid "iCloud saves are available in the iPhone app."
msgstr "iCloud 저장은 iPhone 앱에서 사용할 수 있어요."

msgid "Sign in to Game Center and turn on iCloud Drive to back up progress."
msgstr "Game Center에 로그인하고 iCloud Drive를 켜면 진행 상황을 백업할 수 있어요."

msgid "Checking iCloud for your save…"
msgstr "iCloud 저장 확인 중…"

msgid "No Game Center iCloud save was found. Progress is only on this iPhone. Back Up Now will create a new cloud save."
msgstr "Game Center iCloud 저장 데이터를 찾지 못했어요. 진행 상황은 이 iPhone에만 있어요. 「지금 백업」을 누르면 새 클라우드 저장 데이터가 만들어져요."

msgid "Backing up to iCloud…"
msgstr "iCloud에 백업 중…"

msgid "Waiting to back up recent progress…"
msgstr "최근 진행 상황을 백업하기 위해 대기 중…"

msgid "Backup sent to Game Center iCloud."
msgstr "Game Center iCloud에 백업을 보냈어요."

msgid "Waiting for the first iCloud backup…"
msgstr "첫 iCloud 백업을 기다리는 중이에요…"

msgid "Last downloaded: %s\nLast backed up: %s"
msgstr "마지막 다운로드: %s\n마지막 백업: %s"

msgid "There is no progress to back up yet. If you expected an older save, do not create a new one."
msgstr "아직 백업할 진행 상황이 없어요. 이전 저장 데이터가 있어야 한다면 새 저장 데이터를 만들지 마세요."

msgid "iCloud is unavailable. Your progress is still saved on this iPhone."
msgstr "iCloud를 사용할 수 없어요. 진행 상황은 이 iPhone에 저장돼요."

msgid "Your iCloud save could not be read. This iPhone's save is safe."
msgstr "iCloud 저장 데이터를 읽지 못했어요. 이 iPhone의 저장 데이터는 안전해요."

msgid "Your iCloud save could not be restored. This iPhone's save is safe."
msgstr "iCloud 저장 데이터를 복원하지 못했어요. 이 iPhone의 저장 데이터는 안전해요."

msgid "iCloud backup failed. Your progress is still saved on this iPhone."
msgstr "iCloud 백업에 실패했어요. 진행 상황은 이 iPhone에 저장돼요."

msgid "iCloud backup could not be verified. Your progress is still saved on this iPhone."
msgstr "iCloud 백업을 확인하지 못했어요. 진행 상황은 이 iPhone에 저장돼요."

